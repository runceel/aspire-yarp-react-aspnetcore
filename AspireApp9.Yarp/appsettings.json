{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "server",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "frontend": {
        "ClusterId": "webfrontend",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "server": {
        "Destinations": {
          "server": {
            "Address": "http://server"
          }
        }
      },
      "webfrontend": {
        "Destinations": {
          "webfrontend": {
            "Address": "http://webfrontend"
          }
        }
      }
    }
  }
}
